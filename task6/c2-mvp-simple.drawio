<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram name="C2 - MVP Simple">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="t" value="C2 (MVP): Классификация данных перед DWH"
                style="text;html=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;"
                vertex="1" parent="1">
          <mxGeometry x="180" y="30" width="1240" height="40" as="geometry"/>
        </mxCell>

        <!-- 6 контейнеров + DWH -->
        <mxCell id="src" value="Data Sources"
                style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="raw" value="Raw Storage&#10;(landing)"
                style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="340" y="180" width="240" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="schema" value="Schema Detect&#10;(auto)"
                style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="620" y="180" width="220" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="cls" value="Classifier&#10;(rules + confidence)"
                style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="880" y="180" width="260" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="tz" value="Transform&#10;(mask or quarantine)"
                style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="1180" y="180" width="300" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="zones" value="Zones&#10;Curated / Confidential / Quarantine"
                style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="520" y="340" width="360" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="dwh" value="Analytics DWH"
                style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;"
                vertex="1" parent="1">
          <mxGeometry x="980" y="350" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- потоки -->
        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="src" target="raw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="raw" target="schema">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="schema" target="cls">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="cls" target="tz">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="tz" target="zones">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="batch load" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="zones" target="dwh">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
