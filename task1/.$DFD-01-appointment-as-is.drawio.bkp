<mxfile host="app.diagrams.net">
  <diagram name="DFD-01-Appointment-As-Is">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1"
      connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169"
      pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Пациент -->
        <mxCell id="2" value="Пациент"
          style="shape=rectangle;whiteSpace=wrap;html=1;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- Процесс -->
        <mxCell id="3" value="Процесс: Запись пациента (ресепшен)"
          style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="260" height="100" as="geometry"/>
        </mxCell>

        <!-- Excel журнал -->
        <mxCell id="4" value="Data Store: Excel журнал записей"
          style="shape=rectangle;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="650" y="180" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Файловый сервер -->
        <mxCell id="5" value="Data Store: Файловый сервер"
          style="shape=rectangle;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="650" y="300" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Active Directory -->
        <mxCell id="6" value="Data Store: Active Directory"
          style="shape=rectangle;whiteSpace=wrap;html=1;strokeWidth=2;dashed=1;"
          vertex="1" parent="1">
          <mxGeometry x="650" y="420" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- Врач -->
        <mxCell id="7" value="Врач"
          style="shape=rectangle;whiteSpace=wrap;html=1;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="980" y="300" width="140" height="60" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>